# 运行环境：development（默认）/ production
NODE_ENV=development

# Server
PORT=3000

# JWT 签名密钥：生产环境必须配置至少 16 位的随机字符串，缺失则启动失败
JWT_SECRET=change-me-to-a-long-random-string

# 允许跨域的来源（逗号分隔）。生产环境应改为你的实际域名
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# SQLite 数据库文件路径
DB_PATH=./data/hyt.db

# 初始管理员账号（仅首次启动且无用户时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 对外暴露的站点地址（用于上传文件绝对链接、RSS / sitemap）
PUBLIC_BASE_URL=http://localhost:3000

# 文件存储：local（默认，存本地 uploads/）/ s3（对象存储）
STORAGE_DRIVER=local
# 当 STORAGE_DRIVER=s3 时需要以下配置
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=
