# ====================================================================
# HYT Studio Docker 部署环境变量示例
# 使用方式：cp .env.example .env  然后按需修改后 docker compose up -d
# ====================================================================

# 对外暴露端口（宿主机端口，容器内固定 3000）
PORT=3000

# JWT 签名密钥：生产环境必须修改为至少 16 位的随机字符串！
# 生成方式：openssl rand -hex 32
JWT_SECRET=please-change-me-to-a-long-random-string

# 允许跨域的来源（逗号分隔）。生产环境应改为你的实际域名
# 例如：https://hyt.example.com,https://www.hyt.example.com
CORS_ORIGINS=http://localhost:3000

# 初始管理员账号（仅首次启动且数据库无用户时创建）
# 注意：用此账号首次登录后台时会强制弹窗要求修改密码，改完才能使用
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 对外暴露的站点地址（用于上传文件绝对链接、RSS / sitemap）
PUBLIC_BASE_URL=http://localhost:3000

# 文件存储：local（默认，存容器内 /app/uploads）/ s3（对象存储）
STORAGE_DRIVER=local
# 当 STORAGE_DRIVER=s3 时配置以下项
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_BASE=

# AI SEO 服务配置（在后台「设置 → AI SEO」中也可配置，此处可留空）
# AI_PROVIDER=deepseek
# AI_BASE_URL=https://api.deepseek.com
# AI_API_KEY=
# AI_MODEL=deepseek-chat
